# Copia este archivo como .env y completa los valores. El archivo .env nunca se sube a Git.

# Clave secreta de Django. Genera una con:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=
# True solo en desarrollo
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Base de datos MySQL (ver «Base de datos» en el README)
DB_NAME=festival_votaciones
DB_USER=festival_app
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# ---------------------------------------------------------------------------
# Producción (ejemplo para un despliegue con HTTPS). En el servidor, quita el «#» de cada línea y cambia
# el dominio por el real. Con estos valores, «python manage.py check --deploy» no da advertencias.
# La prueba cuentas.test_permisos.DespliegueTests lee este bloque.
#   DJANGO_DEBUG=False
#   DJANGO_SECRET_KEY=<una clave nueva, distinta de la de desarrollo>
#   DJANGO_ALLOWED_HOSTS=votaciones.example.org
#   DJANGO_CSRF_TRUSTED_ORIGINS=https://votaciones.example.org
#   DJANGO_COOKIES_SEGURAS=True
#   DJANGO_SECURE_SSL_REDIRECT=True
#   DJANGO_SECURE_HSTS_SECONDS=31536000
#   DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=True
#   DJANGO_SECURE_HSTS_PRELOAD=True
#   DJANGO_DETRAS_DE_PROXY=False
