# Copia este archivo como .env y completa los valores. El archivo .env nunca se sube a Git.

# Clave secreta de Django. Genera una con:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=
# True solo en desarrollo
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Base de datos MySQL (ver «Base de datos» en el README)
DB_NAME=festival_votaciones
DB_USER=festival_app
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306
